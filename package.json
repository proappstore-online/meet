{
  "name": "meet",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proappstore-online/meet.git"
  },
  "scripts": {
    "dev": "pnpm --filter @meet/web dev",
    "build": "pnpm --filter @meet/web build",
    "preview": "pnpm --filter @meet/web preview",
    "typecheck": "pnpm --filter @meet/web exec tsc -b",
    "test": "pnpm --filter @meet/web exec tsc -b && pnpm --filter @meet/web test",
    "dev:marketing": "pnpm --filter @meet/marketing dev",
    "build:marketing": "pnpm --filter @meet/marketing build",
    "test:marketing": "node --test tests/marketing-build.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}
